DATABASE_URL="postgresql://user@localhost:5432/join_app_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-value"

# Optional — error tracking. Left empty, Sentry stays inert (no calls sent).
SENTRY_DSN=""

# Local/test keeps OTP delivery in application logs. Production refuses to
# start unless this is set to "providers".
OTP_DELIVERY_MODE="console"

# Email OTP (Resend)
RESEND_API_KEY=""
OTP_FROM_EMAIL="Katıl <giris@example.com>"

# SMS OTP (Twilio) — configure either FROM_NUMBER or MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
