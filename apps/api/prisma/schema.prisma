// Data model source: Katıl-Vault/02-Engineering/Veri-Modeli.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JoinType {
  instant
  approval
}

enum VisibilityScope {
  local
  global
}

enum EventGenderRestriction {
  male
  female
  all
}

enum UserGender {
  male
  female
}

enum ParticipationStatus {
  pending
  approved
  rejected
  joined
}

enum OtpChannel {
  email
  phone
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  emailVerifiedAt       DateTime?
  phone                 String    @unique
  phoneVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  displayName           String
  isPremium             Boolean   @default(false)
  age                   Int?
  bio                   String?
  interests             String[] @default([])
  homeLocationLat       Float?
  homeLocationLng       Float?
  username              String?     @unique
  premiumTrialEndsAt    DateTime?
  gender                UserGender?
  notifyEventReminders  Boolean     @default(true)
  notifyNewParticipants Boolean     @default(true)
  notifyRecommendations Boolean     @default(true)
  createdAt             DateTime    @default(now())

  organizedEvents Event[]         @relation("EventOrganizer")
  participations  Participation[]
}

model Event {
  id                  String          @id @default(uuid())
  organizer           User            @relation("EventOrganizer", fields: [organizerId], references: [id])
  organizerId         String
  title               String
  description         String?
  category            String
  locationLat         Float
  locationLng         Float
  locationLabel       String
  startsAt            DateTime
  capacity            Int?
  joinType            JoinType
  premiumOnlyMatching Boolean                 @default(false)
  visibilityScope     VisibilityScope         @default(local)
  genderRestriction   EventGenderRestriction  @default(all)
  minAge              Int                     @default(13)
  maxAge              Int                     @default(99)
  createdAt           DateTime                @default(now())

  participations Participation[]

  @@index([startsAt])
  @@index([organizerId])
}

model Participation {
  id          String              @id @default(uuid())
  event       Event               @relation(fields: [eventId], references: [id])
  eventId     String
  user        User                @relation(fields: [userId], references: [id])
  userId      String
  status      ParticipationStatus
  requestedAt DateTime            @default(now())
  decidedAt   DateTime?
  rating      EventRating?

  @@unique([eventId, userId])
}

model EventRating {
  id              String        @id @default(uuid())
  participation   Participation @relation(fields: [participationId], references: [id])
  participationId String        @unique
  score           Int
  createdAt       DateTime      @default(now())
}

model OtpCode {
  id         String     @id @default(uuid())
  channel    OtpChannel
  target     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([target, channel])
}
